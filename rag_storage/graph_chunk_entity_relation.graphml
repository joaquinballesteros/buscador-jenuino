    <node id="Adaptación de Metodologías">
      <data key="d0">Adaptación de Metodologías</data>
      <data key="d1">metodologia_docente</data>
      <data key="d2">Ajuste apresurado de los materiales y estrategias docentes para el entorno virtual.</data>
      <data key="d3">chunk-0d13228afa79f86beaf714f410d413c7</data>
      <data key="d4">JENUI_2021_016.pdf</data>
      <data key="d5">1793806420</data>
