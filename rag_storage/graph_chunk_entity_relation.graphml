      <data key="d0">Competencias de Ingeniería del Software</data>
      <data key="d1">competencia</data>
      <data key="d2">Capacidades propias de la ingeniería de software que se refuerzan mediante el desarrollo práctico del procesador de lenguaje.</data>
      <data key="d3">chunk-ce1e5e8c3930ce5e324cf8bc3bbeba63</data>
