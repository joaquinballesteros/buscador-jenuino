      <data key="d0">Proceso Iterativo</data>
      <data key="d1">metodologia_docente</data>
      <data key="d2">Enfoque de trabajo de varios pasos propuesto para llevar a cabo la mejora de prestaciones.</data>
      <data key="d3">chunk-e8117b692260c43def61d71c32d78bbc</data>
