    <node id="Orientación Externa">
      <data key="d0">Orientación Externa</data>
      <data key="d1">contenido_disciplinar</data>
      <data key="d2">Ejemplo de modelo matemático de fotogrametría implementado en la hoja de cálculo, resuelto mediante el método de dos pasos.</data>
      <data key="d3">chunk-414a5c43551f08d13be8c51f803554a7</data>
