    <node id="Simulador de Desarrollo de Software">
      <data key="d0">Simulador de Desarrollo de Software</data>
      <data key="d1">herramienta_docente</data>
      <data key="d2">Instrumento basado en un modelo dinámico que permite experimentar con políticas de gestión de proyectos.</data>
      <data key="d3">chunk-fe52f9050f76991cf499075f1b68dd49</data>
      <data key="d4">JENUI_1999_013.pdf</data>
