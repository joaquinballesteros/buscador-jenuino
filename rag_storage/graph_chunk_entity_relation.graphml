    </node>
    <node id="Plataforma AGORA">
      <data key="d0">Plataforma AGORA</data>
      <data key="d1">herramienta_docente</data>
      <data key="d2">Propuesta de sistema para la gestión e intercambio de objetos de aprendizaje mediante un enfoque de asistencia para la ejecución y control de actividades.</data>
      <data key="d3">chunk-4e5473b54e5628b711e85174c737658b</data>
