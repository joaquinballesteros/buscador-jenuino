    <node id="Desprecio de Mensajes de Error">
      <data key="d0">Desprecio de Mensajes de Error</data>
      <data key="d1">alumnado</data>
      <data key="d2">Actitud técnica nociva consistente en ignorar los mensajes de error del compilador.</data>
      <data key="d3">chunk-1c263ce4b5d0cafe353ff1e0c856fe08</data>
      <data key="d4">JENUI_2002_044.pdf</data>
      <data key="d5">1793807811</data>
