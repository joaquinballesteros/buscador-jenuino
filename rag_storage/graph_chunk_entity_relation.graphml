    <node id="Alumnado de Nuevo Ingreso">
      <data key="d0">Alumnado de Nuevo Ingreso</data>
      <data key="d1">alumnado</data>
      <data key="d2">Estudiantes de primer curso destinatarios de la experiencia de desarrollo de capacidades cognitivas.&lt;SEP&gt;Estudiantes que cursan por primera vez la titulación, objeto específico de la medición del rendimiento.&lt;SEP&gt;Estudiantes de primer curso que reciben la mentoría para facilitar su inserción académica y social.</data>
      <data key="d3">chunk-c122686eec0340bac8de2cb411f2eb2d&lt;SEP&gt;chunk-31bc4f609579a23858321bcbcb4b0b45&lt;SEP&gt;chunk-e7e59476dcbd324403f987c8b5adb253</data>
