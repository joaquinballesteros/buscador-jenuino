    <node id="Lógica de Programación">
      <data key="d0">Lógica de Programación</data>
      <data key="d1">contenido_disciplinar</data>
      <data key="d2">Habilidad básica de razonamiento algorítmico que debe desarrollarse antes de implementar programas en un lenguaje específico.</data>
      <data key="d3">chunk-4be6cfb4ed5831525e4e523b5ac4805c</data>
      <data key="d4">JENUI_2007_042.pdf</data>
