      <data key="d0">Colaboración del Alumnado</data>
      <data key="d1">competencia</data>
      <data key="d2">Capacidad de trabajo en equipo y cooperación que se fomenta al organizar a los 221 estudiantes en equipos para generar preguntas.</data>
      <data key="d3">chunk-fae52fe4e734526edaf298ec512767e1</data>
      <data key="d4">JENUI_2026_054.pdf</data>
      <data key="d5">1793808832</data>
