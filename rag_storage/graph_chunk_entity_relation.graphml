      <data key="d1">contenido_disciplinar</data>
      <data key="d2">Aspecto cualitativo de las preguntas elaboradas por el alumnado, que forma parte del análisis de la estrategia.</data>
      <data key="d3">chunk-fae52fe4e734526edaf298ec512767e1</data>
      <data key="d4">JENUI_2026_054.pdf</data>
      <data key="d5">1793808832</data>
      <data key="d6" />
    </node>
