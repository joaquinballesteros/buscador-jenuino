      <data key="d1">contexto_institucional</data>
      <data key="d2">Nivel de estudios (3, 4 y 5 curso) en el que se imparten las asignaturas de Ingeniería del Software y donde surgen problemas de coherencia en los conocimientos previos.</data>
      <data key="d3">chunk-59855b32361f7ecde449d1d44aa599b5</data>
      <data key="d4">JENUI_1997_004.pdf</data>
      <data key="d5">1793810260</data>
