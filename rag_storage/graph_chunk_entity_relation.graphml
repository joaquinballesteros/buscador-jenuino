      <data key="d0">Validación Automática</data>
      <data key="d1">evaluacion</data>
      <data key="d2">Práctica de evaluación utilizada para corregir o validar las prácticas de laboratorio de forma automática, facilitando la gestión de una gran cantidad de exámenes.</data>
      <data key="d3">chunk-2758f260c03aee361bb3f39acb77e2a4</data>
      <data key="d4">JENUI_2018_036.pdf</data>
      <data key="d5">1793826183</data>
