      <data key="d1">metodologia_docente</data>
      <data key="d2">Estrategia que consiste en acercar al alumnado a la realidad del trabajo en una empresa del mundo real.</data>
      <data key="d3">chunk-b7614fb1843fd8db189bbd7712141e33</data>
