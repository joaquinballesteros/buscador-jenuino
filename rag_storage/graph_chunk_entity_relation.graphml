    </node>
    <node id="Reutilización">
      <data key="d0">Reutilización</data>
      <data key="d1">competencia</data>
      <data key="d2">Práctica de volver a utilizar los objetos de aprendizaje dentro de un flujo de información y nuevos modelos de interacción.</data>
      <data key="d3">chunk-4e5473b54e5628b711e85174c737658b</data>
      <data key="d4">JENUI_2012_047.pdf</data>
      <data key="d5">1793806067</data>
      <data key="d6" />
    </node>
    <node id="E-Learning">
      <data key="d0">E-Learning</data>
      <data key="d1">modalidad_docente</data>
      <data key="d2">Modalidad de enseñanza a distancia o en línea en la que se enmarca la gestión de los recursos educativos.&lt;SEP&gt;Modalidad de educación virtual no presencial que agrupa a personas con diferentes intereses y se caracteriza por ser colaborativa y basada en la comunicación rápida.&lt;SEP&gt;Modalidad de enseñanza apoyada en el uso de nuevas tecnologías y plataformas virtuales para la interacción docente y estudiantil.&lt;SEP&gt;Modalidad de enseñanza universitaria en la que se aplica el framework para la explotación de vídeos interactivos.&lt;SEP&gt;Modalidad de formación a distancia mediante sistemas de aprendizaje en línea a la que se aplica la adaptación.</data>
      <data key="d3">chunk-4e5473b54e5628b711e85174c737658b&lt;SEP&gt;chunk-5ebe2507bbed67aae7b41568f192e711&lt;SEP&gt;chunk-f18ab39933f5e1ed0ae87632eaf3ba03&lt;SEP&gt;chunk-312961ad60bb9086f9c50b32769e6454&lt;SEP&gt;chunk-49fcc4592ad84c25b7ad85ae54682622</data>
      <data key="d4">JENUI_2012_047.pdf&lt;SEP&gt;JENUI_2008_007.pdf&lt;SEP&gt;JENUI_2011_033.pdf&lt;SEP&gt;JENUI_2024_025.pdf&lt;SEP&gt;JENUI_2005_007.pdf</data>
      <data key="d5">1793823881</data>
      <data key="d6" />
    </node>
    <node id="Contexto Institucional">
      <data key="d0">Contexto Institucional</data>
      <data key="d1">contexto_institucional</data>
      <data key="d2">Ambiente de dos instituciones universitarias donde se lleva a cabo la implantación de la plataforma AGORA.</data>
      <data key="d3">chunk-4e5473b54e5628b711e85174c737658b</data>
      <data key="d4">JENUI_2012_047.pdf</data>
      <data key="d5">1793806067</data>
