    <node id="Tamaño del Grupo de Alumnos">
      <data key="d0">Tamaño del Grupo de Alumnos</data>
      <data key="d1">contexto_institucional</data>
      <data key="d2">Disparidad en el número de estudiantes matriculados que condiciona el diseño de metodologías y evaluación.</data>
