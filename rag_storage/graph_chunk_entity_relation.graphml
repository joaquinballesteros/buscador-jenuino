      <data key="d5">1793809936</data>
      <data key="d6" />
    </node>
    <node id="AENUI">
      <data key="d0">AENUI</data>
      <data key="d1">contexto_institucional</data>
      <data key="d2">Asociación que se compromete a recibir el compendio de mini-sermones editado por el ponente.&lt;SEP&gt;Asociación de Enseñantes Universitarios de la Informática que integra profesorado de universidades españolas públicas y privadas.&lt;SEP&gt;Comunidad o asociación de la que forman parte las profesoras y profesores que se reconocen mutuamente su aportación a la docencia.</data>
      <data key="d3">chunk-10cb71d230d4994e648c2738c8469c86&lt;SEP&gt;chunk-f920b40497574d6807e0141ec29106cf&lt;SEP&gt;chunk-abd31a87637a166eaeb3c8fd3bcaa5b2</data>
      <data key="d4">JENUI_2019_003.pdf&lt;SEP&gt;JENUI_2020_003.pdf&lt;SEP&gt;JENUI_2023_001.pdf</data>
      <data key="d5">1793827869</data>
      <data key="d6" />
    </node>
    <node id="Reticencia Docente">
      <data key="d0">Reticencia Docente</data>
      <data key="d1">alumnado</data>
      <data key="d2">Actitud reticente de docentes y autoridades académicas ante las nuevas prácticas educativas, a la que se dirigen los mini-sermones.</data>
      <data key="d3">chunk-10cb71d230d4994e648c2738c8469c86</data>
      <data key="d4">JENUI_2019_003.pdf</data>
      <data key="d5">1793809936</data>
      <data key="d6" />
    </node>
    <node id="Reticencia del Alumnado">
      <data key="d0">Reticencia del Alumnado</data>
      <data key="d1">alumnado</data>
      <data key="d2">Actitud reticente de los estudiantes (discentes) ante el proceso de enseñanza-aprendizaje, citada en el título y contexto del taller.</data>
      <data key="d3">chunk-10cb71d230d4994e648c2738c8469c86</data>
      <data key="d4">JENUI_2019_003.pdf</data>
      <data key="d5">1793809936</data>
