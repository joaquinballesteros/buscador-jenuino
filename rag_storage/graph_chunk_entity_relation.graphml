    <node id="Procesadores de Lenguaje">
      <data key="d0">Procesadores de Lenguaje</data>
      <data key="d1">contenido_disciplinar</data>
      <data key="d2">Asignatura que abarca el aprendizaje de teoría formal y el desarrollo práctico de un procesador de lenguaje.&lt;SEP&gt;Área de conocimiento sobre la construcción de compiladores que se imparte mediante dos asignaturas sucesivas.&lt;SEP&gt;Asignatura troncal en la que se desarrolla la experiencia docente descrita en el texto.&lt;SEP&gt;Componentes del compilador que analizan la sintaxis y semántica del código fuente.</data>
      <data key="d3">chunk-ce1e5e8c3930ce5e324cf8bc3bbeba63&lt;SEP&gt;chunk-37f6d551a7301dd08860bdb697eec481&lt;SEP&gt;chunk-7169016b3b5965f8f6fa2b1525286cfd&lt;SEP&gt;chunk-1fb91d9d857cf8797daed45a6594cf93</data>
      <data key="d4">JENUI_2009_010.pdf&lt;SEP&gt;JENUI_1997_055.pdf&lt;SEP&gt;JENUI_2005_039.pdf&lt;SEP&gt;JENUI_2009_009.pdf</data>
      <data key="d5">1793825352</data>
      <data key="d6" />
    </node>
