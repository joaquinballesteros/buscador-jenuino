    <node id="Programadores sin Lógica">
      <data key="d0">Programadores sin Lógica</data>
      <data key="d1">alumnado</data>
      <data key="d2">Perfil de egresado que se forma cuando se enseña programación directamente en Java sin desarrollar previamente la lógica básica.</data>
      <data key="d3">chunk-4be6cfb4ed5831525e4e523b5ac4805c</data>
      <data key="d4">JENUI_2007_042.pdf</data>
      <data key="d5">1793806330</data>
