    <node id="Proceso de Adaptación en Dos Fases">
      <data key="d0">Proceso de Adaptación en Dos Fases</data>
      <data key="d1">metodologia_docente</data>
      <data key="d2">Estrategia que divide la adaptación del curso en una primera fase de introducción de cambios y una segunda de adaptación completa de contenidos.</data>
      <data key="d3">chunk-ddf36494b2f92650f9eb753a26643c27</data>
      <data key="d4">JENUI_2008_003.pdf</data>
      <data key="d5">1793806050</data>
