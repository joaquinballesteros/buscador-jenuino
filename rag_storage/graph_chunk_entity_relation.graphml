    <node id="Aulas Masificadas">
      <data key="d0">Aulas Masificadas</data>
      <data key="d1">alumnado</data>
      <data key="d2">Condición de los grupos de alumnos, que cuentan con elevado número de estudiantes (102, 60 y 59).&lt;SEP&gt;Situación de elevado número de alumnos en las aulas que dificulta la adaptación de la asignatura.</data>
      <data key="d3">chunk-bf283ad57f545d5c9b1258a2c63d829e&lt;SEP&gt;chunk-6938fb52698d034cbfaf8fddb2c05c47</data>
