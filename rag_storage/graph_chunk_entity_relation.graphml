      <data key="d5">1793823482</data>
      <data key="d6" />
    </node>
    <node id="Kahoot">
      <data key="d0">Kahoot</data>
      <data key="d1">herramienta_docente</data>
      <data key="d2">Plataforma específica de respuesta de audiencia con la que se realizan actividades piloto en diferentes asignaturas.&lt;SEP&gt;Plataforma utilizada para la cuantificación de la participación y el aprovechamiento en los experimentos.&lt;SEP&gt;Plataforma digital empleada para la creación de juegos interactivos y la gestión de test en el aula.&lt;SEP&gt;Herramienta de referencia citada como modelo de juego tipo test.&lt;SEP&gt;Herramienta de aprendizaje móvil electrónico (M-learning) utilizada para crear actividades participativas en el aula.</data>
      <data key="d3">chunk-1c45bd56893526773f0dcf1103b685f5&lt;SEP&gt;chunk-d3fc64820006b5238c1ad8d8fa1eeb6f&lt;SEP&gt;chunk-6f81afb8bb3d80b418d4eabf10276ecb&lt;SEP&gt;chunk-3d9ac29b0a8cfa0f9ee85e47348dc20a&lt;SEP&gt;chunk-3a3c1d80110025ac832a871b34c3ffb4</data>
      <data key="d4">JENUI_2016_040.pdf&lt;SEP&gt;JENUI_2018_032.pdf&lt;SEP&gt;JENUI_2017_034.pdf&lt;SEP&gt;JENUI_2020_020.pdf&lt;SEP&gt;JENUI_2021_040.pdf</data>
      <data key="d5">1793813998</data>
