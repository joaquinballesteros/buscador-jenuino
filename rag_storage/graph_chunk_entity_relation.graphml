      <data key="d1">herramienta_docente</data>
      <data key="d2">Representación gráfica que el estudiante crea para diseñar los modelos de autómatas en Thoth.</data>
      <data key="d3">chunk-bb6c098f1eecefdc17000c5cb756effb</data>
      <data key="d4">JENUI_2008_072.pdf</data>
