    <node id="Gestión de Objetos de Aprendizaje">
      <data key="d0">Gestión de Objetos de Aprendizaje</data>
      <data key="d1">metodologia_docente</data>
      <data key="d2">Conjunto de actividades asociadas al desarrollo, control e interconexión de herramientas para el manejo de recursos educativos.</data>
      <data key="d3">chunk-4e5473b54e5628b711e85174c737658b</data>
      <data key="d4">JENUI_2012_047.pdf</data>
      <data key="d5">1793806067</data>
