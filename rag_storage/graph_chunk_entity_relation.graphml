    <node id="Ordocoordinación">
      <data key="d0">Ordocoordinación</data>
      <data key="d1">metodologia_docente</data>
      <data key="d2">Forma de coordinación docente flexible, rápida y de abajo hacia arriba, basada en la generación y consenso de un conjunto mínimo de reglas para gestionar grandes grupos de estudiantes.</data>
      <data key="d3">chunk-2758f260c03aee361bb3f39acb77e2a4</data>
      <data key="d4">JENUI_2018_036.pdf</data>
      <data key="d5">1793826183</data>
