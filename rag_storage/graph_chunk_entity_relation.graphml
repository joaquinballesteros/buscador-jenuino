    <node id="Sistemas Operativos I">
      <data key="d0">Sistemas Operativos I</data>
      <data key="d1">contenido_disciplinar</data>
      <data key="d2">Asignatura de informática objeto de la adaptación metodológica descrita en el texto.&lt;SEP&gt;Asignatura de introducción a los sistemas operativos cuyo contenido y enfoque teórico se discuten en el artículo.</data>
