      <data key="d0">Calidad del Trabajo</data>
      <data key="d1">competencia</data>
      <data key="d2">Criterio de evaluación centrado en la calidad del trabajo desarrollado en el proyecto.</data>
      <data key="d3">chunk-60acfa2c4cd12e3cf1cfb5e323daaeea</data>
      <data key="d4">JENUI_2017_010.pdf</data>
