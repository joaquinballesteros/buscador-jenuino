      <data key="d0">Análisis Semántico</data>
      <data key="d1">contenido_disciplinar</data>
      <data key="d2">Fase de compilación descrita mediante formalismos como las gramáticas atribuidas y objeto de desarrollo práctico.</data>
      <data key="d3">chunk-ce1e5e8c3930ce5e324cf8bc3bbeba63</data>
