    </node>
    <node id="Objeto de Aprendizaje">
      <data key="d0">Objeto de Aprendizaje</data>
      <data key="d1">contenido_disciplinar</data>
      <data key="d2">Recurso educativo digital gestionado, desarrollado e intercambiado por los usuarios a través de la plataforma AGORA y los repositorios.&lt;SEP&gt;Unidad de contenido didáctico que se modela para construir rutas de aprendizaje.&lt;SEP&gt;Material docente elaborado por los propios estudiantes para guiar y apoyar el proceso de aprendizaje.</data>
      <data key="d3">chunk-4e5473b54e5628b711e85174c737658b&lt;SEP&gt;chunk-46307653be02be764e3b5ed8bc6e3579&lt;SEP&gt;chunk-e3baf76962fcf7001d2c2d666d091166</data>
