    <node id="Aprendizaje por Descubrimiento">
      <data key="d0">Aprendizaje por Descubrimiento</data>
      <data key="d1">metodologia_docente</data>
      <data key="d2">Técnica docente de las propuestas para la formación por competencias que fomenta el aprendizaje activo.</data>
      <data key="d3">chunk-a3b7e291480aa9b7206a6991079d78a9</data>
