      <data key="d0">Preparación Técnica</data>
      <data key="d1">alumnado</data>
      <data key="d2">Nivel de conocimiento técnico que el alumnado posee al iniciar los proyectos, descrito como aceptable.</data>
      <data key="d3">chunk-2092e570cbd9f799c946f7ea81dddf65</data>
      <data key="d4">JENUI_1999_032.pdf</data>
      <data key="d5">1793813068</data>
      <data key="d6" />
    </node>
