    </node>
    <node id="Matriz de Sostenibilidad">
      <data key="d0">Matriz de Sostenibilidad</data>
      <data key="d1">herramienta_docente</data>
      <data key="d2">Instrumento estructurado en celdas con preguntas para guiar el análisis de sostenibilidad.&lt;SEP&gt;Instrumento o estructura de evaluación propuesto para el análisis de la sostenibilidad en el Trabajo de Fin de Grado.</data>
      <data key="d3">chunk-7458a54ce85763ebf7a2ae40833deb4e&lt;SEP&gt;chunk-25137d6a020e7189f4c5f7bf6433cbee</data>
