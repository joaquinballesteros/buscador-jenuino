    <node id="Teletrabajo">
      <data key="d0">Teletrabajo</data>
      <data key="d1">modalidad_docente</data>
      <data key="d2">Forma de trabajo a distancia mediante herramientas informáticas que se difunde en el método.</data>
      <data key="d3">chunk-f23574ebd828991c1a4e0df78c46a8ef</data>
