    <node id="Mentoría Profesional">
      <data key="d0">Mentoría Profesional</data>
      <data key="d1">metodologia_docente</data>
      <data key="d2">Modelo de acompañamiento estudiantil donde profesionales egresados comparten su experiencia y conocimiento con alumnos de últimos cursos para facilitar su incorporación al mercado laboral.</data>
