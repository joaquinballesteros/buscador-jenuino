    <node id="Evaluación por Encuesta">
      <data key="d0">Evaluación por Encuesta</data>
      <data key="d1">evaluacion</data>
      <data key="d2">Instrumento utilizado para medir la aceptación, motivación e implicación del alumnado tras la experiencia.&lt;SEP&gt;Instrumento utilizado para recoger los resultados y percepciones de los estudiantes sobre la adaptación de la materia.</data>
      <data key="d3">chunk-d5757074a6cefda64558f95b3791e1c6&lt;SEP&gt;chunk-c45e4bd00a2d64c0e7e235f756cfba18</data>
