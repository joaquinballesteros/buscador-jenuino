    <node id="Humor">
      <data key="d0">Humor</data>
      <data key="d1">metodologia_docente</data>
      <data key="d2">Recurso retórico empleado para facilitar la llegada del mensaje al alumnado y evitar la resistencia.</data>
      <data key="d3">chunk-1c263ce4b5d0cafe353ff1e0c856fe08</data>
      <data key="d4">JENUI_2002_044.pdf</data>
      <data key="d5">1793807811</data>
      <data key="d6" />
    </node>
    <node id="Copiamiento">
      <data key="d0">Copiamiento</data>
      <data key="d1">alumnado</data>
      <data key="d2">Actitud deontológica nociva consistente en copiar prácticas, difícil de erradicar a pesar de las advertencias.</data>
      <data key="d3">chunk-1c263ce4b5d0cafe353ff1e0c856fe08</data>
      <data key="d4">JENUI_2002_044.pdf</data>
      <data key="d5">1793807811</data>
      <data key="d6" />
    </node>
    <node id="Codificación Apresurada">
      <data key="d0">Codificación Apresurada</data>
      <data key="d1">alumnado</data>
      <data key="d2">Actitud técnica nociva caracterizada por una codificación desordenada y precipitada.</data>
      <data key="d3">chunk-1c263ce4b5d0cafe353ff1e0c856fe08</data>
      <data key="d4">JENUI_2002_044.pdf</data>
      <data key="d5">1793807811</data>
