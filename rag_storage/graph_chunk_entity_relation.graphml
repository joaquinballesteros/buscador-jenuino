    <node id="Criterio Incremental de Evaluación">
      <data key="d0">Criterio Incremental de Evaluación</data>
      <data key="d1">evaluacion</data>
      <data key="d2">Criterio de evaluación que permite un control exhaustivo de los conocimientos del alumnado al aprobar, estableciendo umbrales distintos según el nivel de los contenidos.</data>
      <data key="d3">chunk-15a8c1dfa0dc11521981304db236ff9c</data>
      <data key="d4">JENUI_2008_081.pdf</data>
      <data key="d5">1793809932</data>
      <data key="d6" />
    </node>
