      <data key="d1">contenido_disciplinar</data>
      <data key="d2">Asignatura introductoria de informática impartida en el nuevo campus, que requiere una organización docente singular debido al gran volumen de alumnado.</data>
      <data key="d3">chunk-2758f260c03aee361bb3f39acb77e2a4</data>
      <data key="d4">JENUI_2018_036.pdf</data>
      <data key="d5">1793826183</data>
