    <node id="Comunidad Universitaria">
      <data key="d0">Comunidad Universitaria</data>
      <data key="d1">alumnado</data>
      <data key="d2">Conjunto de colectivos con responsabilidades distintas dentro de la universidad que se ven afectados por los cambios normativos.&lt;SEP&gt;Colectivo (profesores, equipos directivos y estudiantes) que se beneficia del trabajo de los innovadores y participa en el espacio cooperativo.</data>
      <data key="d3">chunk-2c258a41005b93cfddff49ce73e9d94a&lt;SEP&gt;chunk-22d9a6573ccbf8ae48038aeea162ccd8</data>
