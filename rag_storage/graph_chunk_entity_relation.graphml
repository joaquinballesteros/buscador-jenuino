    <node id="Asignaturas Técnicas">
      <data key="d0">Asignaturas Técnicas</data>
      <data key="d1">contexto_institucional</data>
      <data key="d2">Grupo de asignaturas de carácter técnico donde se analiza la implantación de la evaluación de competencias.</data>
      <data key="d3">chunk-02d181e3f6144f4a7021ab4c49543e75</data>
      <data key="d4">JENUI_2008_033.pdf</data>
      <data key="d5">1793806235</data>
