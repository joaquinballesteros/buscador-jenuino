    </node>
    <node id="Metodología de Programación">
      <data key="d0">Metodología de Programación</data>
      <data key="d1">metodologia_docente</data>
      <data key="d2">Enfoque didáctico que separa el aprendizaje de la lógica algorítmica de la implementación en un lenguaje específico.</data>
