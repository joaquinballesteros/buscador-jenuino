      <data key="d0">Ofertas de Empleo</data>
      <data key="d1">contexto_institucional</data>
      <data key="d2">Fuente de datos de periódicos nacionales usada para analizar la demanda de competencias por el mercado laboral.</data>
      <data key="d3">chunk-02d181e3f6144f4a7021ab4c49543e75</data>
