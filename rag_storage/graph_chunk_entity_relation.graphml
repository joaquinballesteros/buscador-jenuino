      <data key="d6" />
    </node>
    <node id="Capacidad de Análisis">
      <data key="d0">Capacidad de Análisis</data>
      <data key="d1">competencia</data>
      <data key="d2">Capacidad cognitiva superior desarrollada al calificar el trabajo de los compañeros.&lt;SEP&gt;Objetivo formativo de que los estudiantes sean capaces de describir y analizar el funcionamiento de los protocolos.&lt;SEP&gt;Capacidad cognitiva que se entrena al realizar tareas de ponderación y consideración de alternativas dentro de la evaluación entre compañeros.</data>
      <data key="d3">chunk-c122686eec0340bac8de2cb411f2eb2d&lt;SEP&gt;chunk-92d5f7a2bc62d32bfe7fc8bc9762e19a&lt;SEP&gt;chunk-6fd4121a7c366e1a76f70ebd380e7b1a</data>
