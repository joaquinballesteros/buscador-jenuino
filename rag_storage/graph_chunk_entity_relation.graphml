    </node>
    <node id="Herramientas Orientadas a Objetos">
      <data key="d0">Herramientas Orientadas a Objetos</data>
      <data key="d1">herramienta_docente</data>
      <data key="d2">Software de desarrollo basado en el paradigma de objetos cuya creciente utilización justifica la necesidad de profundizar en la formación.</data>
      <data key="d3">chunk-7f3bb3d80060ba9e9223286ded210d34</data>
      <data key="d4">JENUI_1998_022.pdf</data>
      <data key="d5">1793806069</data>
