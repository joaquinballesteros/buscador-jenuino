      <data key="d0">Esfuerzo de Desarrollo</data>
      <data key="d1">alumnado</data>
      <data key="d2">Esfuerzo que realizan los estudiantes al trabajar en los proyectos de la asignatura.</data>
      <data key="d3">chunk-2f79df35a8e47c4193aa19faa8b44fb5</data>
      <data key="d4">JENUI_2021_035.pdf</data>
