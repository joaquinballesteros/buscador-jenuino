    <node id="Enseñanza en Negativo">
      <data key="d0">Enseñanza en Negativo</data>
      <data key="d1">metodologia_docente</data>
      <data key="d2">Enfoque pedagógico que utiliza el humor y la ironía para advertir sobre prácticas incorrectas en lugar de dar consejos directos.</data>
      <data key="d3">chunk-1c263ce4b5d0cafe353ff1e0c856fe08</data>
      <data key="d4">JENUI_2002_044.pdf</data>
      <data key="d5">1793807811</data>
