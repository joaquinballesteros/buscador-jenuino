    <node id="Herramientas de Respuesta de Audiencia">
      <data key="d0">Herramientas de Respuesta de Audiencia</data>
      <data key="d1">herramienta_docente</data>
      <data key="d2">Sistemas que permiten introducir procesos de participación activa en el aula mediante dispositivos móviles, facilitando la innovación docente con un coste mínimo.</data>
      <data key="d3">chunk-1c45bd56893526773f0dcf1103b685f5</data>
      <data key="d4">JENUI_2016_040.pdf</data>
      <data key="d5">1793808179</data>
